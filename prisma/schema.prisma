// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hobby {
  id                    String   @id @default(uuid())
  name                  String
  color                 String
  icon                  String?
  sortOrder             Int      @default(0) @map("sort_order")
  hoursTrackingEnabled  Boolean  @default(false) @map("hours_tracking_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  projects       Project[]
  ideas          Idea[]
  inventoryItems InventoryItem[]

  @@map("hobby")
}

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String?
  hobbyId        String   @map("hobby_id")
  isArchived     Boolean  @default(false) @map("is_archived")
  isCompleted    Boolean  @default(false) @map("is_completed")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Gallery fields
  journeyGalleryEnabled Boolean  @default(false) @map("journey_gallery_enabled")
  resultGalleryEnabled  Boolean  @default(false) @map("result_gallery_enabled")
  gallerySlug           String?  @unique @map("gallery_slug")
  resultStepId          String?  @unique @map("result_step_id")

  hobby      Hobby     @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  steps      Step[]
  resultStep Step?     @relation("ResultStep", fields: [resultStepId], references: [id], onDelete: SetNull)
  bomItems   BomItem[]

  // Supports the hobby project list base case (no boolean filter) and any
  // Project-by-hobby query that doesn't filter on isArchived/isCompleted.
  // Story 18.2 baseline.
  @@index([hobbyId, lastActivityAt])

  // Story 33.6 — supports the hobby detail page, which filters
  // `where: { hobbyId, isArchived: false, isCompleted: false }` and orders
  // by lastActivityAt. Includes the booleans in the index so Postgres can
  // skip rows during the index scan rather than filter post-fetch.
  @@index([hobbyId, isArchived, isCompleted, lastActivityAt])

  // Story 33.6 — supports the dashboard's `recentProjects` and `idleProjects`
  // queries which filter on the booleans WITHOUT a hobbyId filter and order
  // by lastActivityAt. The 4-col composite above doesn't help these because
  // Postgres reads B-tree indexes left-to-right (no leading hobbyId filter →
  // can't use it).
  @@index([isArchived, isCompleted, lastActivityAt])

  @@map("project")
}

enum StepState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model Step {
  id            String     @id @default(uuid())
  name          String
  projectId     String     @map("project_id")
  state         StepState  @default(NOT_STARTED)
  previousState StepState? @map("previous_state")
  sortOrder     Int        @default(0) @map("sort_order")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  excludeFromGallery Boolean  @default(false) @map("exclude_from_gallery")
  hoursLogged        Decimal? @db.Decimal(5, 1) @map("hours_logged")

  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resultForProject Project?    @relation("ResultStep")
  notes            StepNote[]
  blockers         Blocker[]
  images           StepImage[]

  // Supports the project detail page's ordered step list (WHERE project_id = ?
  // ORDER BY sort_order). Story 18.2.
  @@index([projectId, sortOrder])
  @@map("step")
}

model StepNote {
  id        String   @id @default(uuid())
  stepId    String   @map("step_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("step_note")
}

// NOTE: A partial unique index `blocker_step_inv_unresolved_unique` on
// (step_id, inventory_item_id) WHERE is_resolved = false AND inventory_item_id
// IS NOT NULL is applied via prisma/post-push.mjs. Prisma cannot express
// partial indexes in schema.prisma. See Story 18.1 — closes the TOCTOU race
// between dedup check and insert in createBomShortageBlocker.
model Blocker {
  id              String         @id @default(uuid())
  stepId          String         @map("step_id")
  description     String
  isResolved      Boolean        @default(false) @map("is_resolved")
  inventoryItemId String?        @map("inventory_item_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  step          Step           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  // Supports the dashboard Active Blockers section (WHERE is_resolved = false
  // ORDER BY created_at DESC). Story 18.2.
  @@index([isResolved, createdAt])
  @@map("blocker")
}

model Idea {
  id            String   @id @default(uuid())
  hobbyId       String   @map("hobby_id")
  title         String
  description   String?
  referenceLink String?  @map("reference_link")
  isPromoted    Boolean  @default(false) @map("is_promoted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  hobby Hobby     @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  image IdeaImage?

  @@map("idea")
}

model IdeaImage {
  id               String        @id @default(uuid())
  ideaId           String        @unique @map("idea_id")
  storageKey       String?       @map("storage_key")
  originalFilename String?       @map("original_filename")
  contentType      String?       @map("content_type")
  sizeBytes        Int?          @map("size_bytes")
  type             StepImageType @default(UPLOAD)
  url              String?
  createdAt        DateTime      @default(now()) @map("created_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  // Note: @@unique([ideaId]) already creates a B-tree index covering FK lookups,
  // so no additional @@index is needed (unlike step_image/inventory_item_image,
  // which are 1-to-many and need an explicit FK index).
  @@map("idea_image")
}

enum InventoryItemType {
  MATERIAL
  CONSUMABLE
  TOOL
}

model InventoryItem {
  id        String            @id @default(uuid())
  name      String
  type      InventoryItemType
  quantity  Float?
  unit      String?
  notes     String?
  isDeleted Boolean           @default(false) @map("is_deleted")
  deletedAt DateTime?         @map("deleted_at")
  lastMaintenanceDate     DateTime? @map("last_maintenance_date")
  maintenanceIntervalDays Int?      @map("maintenance_interval_days")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  blockers Blocker[]
  bomItems BomItem[]
  hobbies  Hobby[]
  images   InventoryItemImage[]

  // Unique index UNIQUE(lower(name)) WHERE is_deleted = false enforced via raw SQL in migration
  // (Prisma cannot express partial/functional unique indexes natively).

  // Story 33.6 — supports the inventory list query
  // `where: { isDeleted: false, type? }` so Postgres can index-scan
  // active items by type rather than seq-scanning + filtering on the
  // boolean. isDeleted leads because it's the more selective filter
  // (active items dominate; type narrows further).
  @@index([isDeleted, type])

  @@map("inventory_item")
}

enum BomConsumptionState {
  NOT_CONSUMED
  CONSUMED
}

model BomItem {
  id               String              @id @default(uuid())
  projectId        String              @map("project_id")
  inventoryItemId  String?             @map("inventory_item_id")
  label            String?
  requiredQuantity Float               @map("required_quantity")
  unit             String?
  consumptionState BomConsumptionState @default(NOT_CONSUMED) @map("consumption_state")
  consumedAt       DateTime?           @map("consumed_at")
  unconsumedAt     DateTime?           @map("unconsumed_at")
  sortOrder        Int                 @default(0) @map("sort_order")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  // Partial unique index UNIQUE(project_id, inventory_item_id) WHERE inventory_item_id IS NOT NULL
  // applied via prisma/post-push.mjs.
  //
  // Supports the BOM section's ordered list on the project detail page
  // (WHERE project_id = ? ORDER BY sort_order). The CREATE INDEX was
  // historically issued by the catchup migration but never declared
  // here, so every `prisma migrate dev` would auto-generate a `DROP
  // INDEX` to "fix" the drift. Story 33.3 declares the index here so
  // the schema and migrations stay in parity.
  @@index([projectId, sortOrder])
  @@map("bom_item")
}

enum StepImageType {
  UPLOAD
  LINK
}

enum StepMediaType {
  IMAGE
  VIDEO
}

model StepImage {
  id               String        @id @default(uuid())
  stepId           String        @map("step_id")
  storageKey       String?       @map("storage_key")
  originalFilename String?       @map("original_filename")
  contentType      String?       @map("content_type")
  sizeBytes        Int?          @map("size_bytes")
  type             StepImageType @default(UPLOAD)
  mediaType        StepMediaType @default(IMAGE) @map("media_type")
  durationSeconds  Int?          @map("duration_seconds")
  url              String?
  createdAt        DateTime      @default(now()) @map("created_at")

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  // FK index baseline (Story 22.3).
  @@index([stepId])

  // Story 33.6 — supports `fetchLatestPhotosByProject`'s
  // `WHERE step.projectId IN (...) ORDER BY step_image.created_at DESC`
  // pattern. The composite lets Postgres index-scan the join + sort
  // together rather than sequential-scanning step_image and sorting in
  // memory. Sort: Desc matches the query's order-by.
  @@index([stepId, createdAt(sort: Desc)])
  @@map("step_image")
}

model InventoryItemImage {
  id               String        @id @default(uuid())
  inventoryItemId  String        @map("inventory_item_id")
  storageKey       String?       @map("storage_key")
  originalFilename String?       @map("original_filename")
  contentType      String?       @map("content_type")
  sizeBytes        Int?          @map("size_bytes")
  type             StepImageType @default(UPLOAD)
  url              String?
  createdAt        DateTime      @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@map("inventory_item_image")
}

enum ReminderTargetType {
  STEP
  PROJECT
}

model Reminder {
  id           String             @id @default(uuid())
  targetType   ReminderTargetType @map("target_type")
  targetId     String             @map("target_id")
  dueDate      DateTime           @map("due_date")
  isDismissed  Boolean            @default(false) @map("is_dismissed")
  snoozedUntil DateTime?          @map("snoozed_until")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([targetType, targetId])
  @@index([dueDate])
  @@map("reminder")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("setting")
}
